    "types": [
      {
        "name": "onchain_id::state::Config",
        "docs": [
          "Program config: who is allowed to set `verified` on identities (after off-chain KYC)."
        ],
        "type": {
          "kind": "struct",
          "fields": [
            {
              "name": "authority",
              "docs": [
                "Authority that can call set_verified (e.g. your backend after Persona KYC)."
              ],
              "type": "pubkey"
            },
            {
              "name": "bump",
              "type": "u8"
            }
          ]
        }
      },
      {
        "name": "onchain_id::state::Identity",
        "type": {
          "kind": "struct",
          "fields": [
            {
              "name": "authority",
              "docs": [
                "The user who owns this identity; only they can add/remove wallets."
              ],
              "type": "pubkey"
            },
            {
              "name": "bump",
              "docs": [
                "PDA bump."
              ],
              "type": "u8"
            },
            {
              "name": "verified",
              "docs": [
                "Set by program authority (later step) after off-chain KYC."
              ],
              "type": "bool"
            },
            {
              "name": "wallets",
              "docs": [
                "Wallets linked to this identity (e.g. can receive mint to these)."
              ],
              "type": {
                "vec": "pubkey"
              }
            }
          ]
        }
      }
    ],
